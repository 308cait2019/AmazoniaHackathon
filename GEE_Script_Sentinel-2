// Reproject EPSG:4326 WGS84 at a 10-meter degree scaled imagery before exporting
var compositeWGS84 = composite2026.select(['B4', 'B3', 'B2']).reproject({
  crs: 'EPSG:4326',
  scale: 10 // Earth Engine translates this 10m request into the correct degree equivalent for EPSG:4326
});

// Export using matching CRS parameters
Export.image.toDrive({
  image: compositeWGS84,
  description: 'Paragominas_Sentinel2_2026_WGS84',
  folder: 'Amazonia_Hackathon_Paragominas_QField_Basemap_Sentinel2',
  region: exportBounds,
  crs: 'EPSG:4326',
  scale: 10,
  maxPixels: 1e13
});

